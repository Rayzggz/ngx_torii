ngx_addon_name=ngx_http_torii_module

NGX_HTTP_TORII_MODULE_SRCS="$ngx_addon_dir/src/ngx_http_torii_module.c"

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=$ngx_addon_name
    ngx_module_incs=
    ngx_module_deps=
    ngx_module_srcs="$NGX_HTTP_TORII_MODULE_SRCS"
    ngx_module_libs=

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES $ngx_addon_name"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $NGX_HTTP_TORII_MODULE_SRCS"
fi
